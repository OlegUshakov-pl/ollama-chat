# Ollama Chat email tools settings (check_email / send_email)
#
# Copy this file to ".env" (in the directory you run ollama-chat from) and fill in your values.
# Keep ".env" private - it contains your password and must never be committed to git.

# IMAP server used by check_email (reading emails)
EMAIL_IMAP_HOST=imap.example.com
EMAIL_IMAP_PORT=993

# SMTP server used by send_email (sending emails)
# Port 465 uses implicit SSL/TLS; port 587 (or any other port) uses STARTTLS
EMAIL_SMTP_HOST=smtp.example.com
EMAIL_SMTP_PORT=465

# The mailbox login and an app password - use an application password, not your main one
EMAIL_USER=you@example.com
EMAIL_PASSWORD=your-application-password

# Optional: the From address if it differs from EMAIL_USER
# EMAIL_FROM=you@example.com
