group


# The user-model conversation info
struct ConversationInfo

    # The conversation identifier
    string id

    # The model ID
    string model

    # The conversation's AI provider ID. Old conversations have no provider - they use local
    # Ollama.
    optional string provider

    # The conversation title
    string title

    # The scheduled task's identifier, for conversations holding a task's run report
    optional string taskId


# A scheduled task's info
struct TaskInfo

    # The task identifier
    string id

    # The task name
    string name

    # The daily run time, "HH:MM"
    string time

    # The run days - ISO weekdays, Monday is 1 and Sunday is 7
    int[] days

    # The model ID
    string model

    # The task's last run time, or null
    optional string lastRun

    # The task's last error message, or null
    optional string lastError

    # If true, the task is running now
    optional bool running


# A scheduled task's full info, for the tasks page
struct TaskDetails (TaskInfo)

    # The task prompt
    string prompt

    # The context size (num_ctx), or null for default
    optional int numCtx

    # The maximum number of tool-call rounds, 1-50, or null for the default (5)
    optional int(>= 1, <= 50) toolRounds

    # The allowed tools
    string[] tools

    # If true, the task runs on its schedule
    optional bool enabled


# A scheduled task's create/update input. With an "id" member the named task is updated,
# otherwise a new task is created.
struct TaskInput

    # The task identifier
    optional string id

    # The task name
    string name

    # The daily run time, "HH:MM"
    string time

    # The run days - ISO weekdays, Monday is 1 and Sunday is 7
    int[] days

    # The model ID
    string model

    # The task prompt
    string prompt

    # The context size (num_ctx), or null for default
    optional int numCtx

    # The maximum number of tool-call rounds, 1-50, or null for the default (5)
    optional int(>= 1, <= 50) toolRounds

    # The allowed tools
    string[] tools

    # If true, the task runs on its schedule (the default is true)
    optional bool enabled


# A task's run log
struct TaskLog

    # The task's log text, or null when there are no log entries
    optional string log


# An email settings summary. The saved app password is never included - only whether one is
# saved (hasPassword).
struct EmailSettings

    # The IMAP server host
    string imapHost

    # The IMAP server port
    int imapPort

    # The SMTP server host
    string smtpHost

    # The SMTP server port
    int smtpPort

    # The mailbox login
    string user

    # True when an app password is saved in the .env file
    bool hasPassword


# The workspace and email settings
struct SettingsInfo

    # The workspace directory
    string workspace

    # The email settings
    EmailSettings email
    optional string lastError

    # The current model ID
    optional string model

    # The current provider ID
    optional string provider


# The user profile - the USER.md content and its character limit
struct ProfileInfo

    # The USER.md markdown content
    string content

    # The max USER.md content length - longer content is rejected by setProfile
    int limit


# The user-model conversation info with generating status
struct ConversationInfoEx (ConversationInfo)

    # If True, the latest exchange is actively generating
    bool generating


# A user-model conversation
struct Conversation (ConversationInfo)

    # The conversation's exchanges
    ConversationExchange[] exchanges


# A user-model conversation with generating status
struct ConversationEx (Conversation)

    # If True, the latest exchange is actively generating
    bool generating


# A conversation user-model exchange
struct ConversationExchange

    # The user prompt
    string user

    # The model response
    string model

    # The model's thinking
    optional string thinking

    # The exchange's attached file references (at most 10)
    optional ConversationFileRef[len <= 10] files

    # The web tool calls the model made during this exchange
    optional ConversationTool[] tools

    # The email draft created by the model, awaiting the user's send confirmation
    optional EmailDraft email


# A web tool call made by the model
struct ConversationTool

    # The tool action - 'search' (web_search), 'open' (fetch_page), 'check' (check_email) or
    # 'send' (drafted email awaiting confirmation)
    string action

    # The search query, the page URL or the email summary (e.g. "2 unread")
    string value


# An email draft created by the model, awaiting the user's send confirmation
struct EmailDraft

    # The draft recipient address(es)
    string to

    # The draft subject
    string subject

    # The draft body
    string body

    # True once the user confirmed sending the email
    optional bool sent


# A conversation template info struct
struct ConversationTemplateInfo

    # The template identifier
    string id

    # The template title
    string title


# A conversation template
struct ConversationTemplate (ConversationTemplateInfo)

    # The template command name
    optional string name

    # The template user prompts
    string[] prompts

    # The template variables (e.g. "{{var}}")
    optional ConversationTemplateVariable[len > 0] variables


# A conversation template variable
struct ConversationTemplateVariable

    # The variable name (e.g. "CityState")
    string name

    # The variable's label (e.g. "The City and State (e.g. Seattle, WA)")
    string label


# A conversation file attachment
struct ConversationFile

    # The file name
    string name

    # The file MIME type
    string type

    # The file data (base64 encoded)
    string data


# A stored conversation file reference - just enough to show the attachment in the chat
struct ConversationFileRef

    # The file name
    string name

    # The file MIME type
    optional string type


# Model information
struct ModelInfo

    # The model ID
    string id

    # The model name
    string name

    # The parameter count
    int parameters

    # The size, in bytes
    int size

    # The last modified date
    datetime modified


# An AI provider's configuration, stored in the config file
struct ProviderConfig

    # The provider identifier (e.g. "openai"), referenced by conversations and tasks
    string id

    # The provider's display name
    string name

    # The provider's API type - "ollama", "openai", "anthropic", "google" or "custom"
    string type

    # The API base URL. When unset, a built-in provider uses its documented default and local
    # Ollama uses the OLLAMA_HOST environment variable.
    optional string baseUrl

    # The AES-GCM encrypted API key, hex "iv:cipher16:cipher" format. Never sent to the
    # browser - only its mask is.
    optional string apiKeyEnc

    # The default model ID
    optional string defaultModel

    # If true, the provider is available for chats (the default is true)
    optional bool enabled

    # If true, the provider is built in - it can be disabled but not deleted
    optional bool builtIn


# An AI provider's info for the settings page. The API key is never included - only whether
# one is saved (hasApiKey) and its mask.
struct ProviderInfo

    # The provider identifier
    string id

    # The provider's display name
    string name

    # The provider's API type - "ollama", "openai", "anthropic", "google" or "custom"
    string type

    # The provider's effective base URL
    optional string baseUrl

    # The default model ID
    optional string defaultModel

    # If true, the provider is available for chats
    bool enabled

    # If true, the provider is built in - it can be disabled but not deleted
    bool builtIn

    # True when an API key is saved
    bool hasApiKey

    # The saved API key's display mask, when one is saved
    optional string apiKeyMask


# A provider create/update input. With an "id" member the named provider is updated,
# otherwise a new custom provider is created. The API key is write-only: an empty value keeps
# the saved key and "deleteApiKey" erases it.
struct ProviderInput

    # The provider identifier, for an update
    optional string id

    # The provider's display name
    string name

    # The API base URL. An empty value restores the provider's default.
    optional string baseUrl

    # The API key. An empty value keeps the saved key.
    optional string apiKey

    # If true, delete the saved API key
    optional bool deleteApiKey

    # The default model ID
    optional string defaultModel

    # If true, the provider is enabled for chats
    optional bool enabled


# A provider's available model
struct ProviderModelInfo

    # The model ID
    string id

    # The model name
    string name


# Model download information
struct ModelDownloadInfo

    # The model ID
    string id

    # The download status
    string status

    # The number of bytes downloaded so far
    int completed

    # The size, in bytes. This member is not present while the download is starting.
    optional int size


group "Ollama Chat JSON"


# The Ollama Chat config file format
struct OllamaChatConfig

    # The current model ID
    optional string model

    # The current AI provider ID, for new conversations (the default is "ollama")
    optional string provider

    # The saved conversations
    Conversation[] conversations

    # The AI providers
    optional ProviderConfig[] providers

    # The conversation templates
    optional ConversationTemplate[] templates

    # The workspace directory. If not set, the default is the environment variable
    # OLLAMA_CHAT_WORKSPACE, or "~/ollama-chat-workspace".
    optional string workspace

    # The workspace memory character limit (default is 3000)
    optional int memoryLimit

    # The user profile (memory/USER.md) character limit (default is 1500)
    optional int profileLimit

    # If true, run tasks missed within the last 24 hours at application start (default is false)
    optional bool tasksCatchUp

    # If true, don't save the config file
    optional bool noSave


group "Ollama Chat Models JSON"


# The Ollama Chat downloadable models file format
typedef OllamaChatModel[len > 0] OllamaChatModels


group


# A downloadable model
struct OllamaChatModel

    # The model name
    string name

    # The model's description
    string description

    # The model's last modified date
    date modified

    # The model's download count
    int downloads

    # The model variants
    OllamaChatModelVariant[len > 0] variants


# A downloadable model variant
struct OllamaChatModelVariant

    # The variant's ID
    string id

    # The variant's tag
    string size

    # The variant's parameter count (0 if unknown)
    int parameters

    # If true, the variant runs in the Ollama cloud
    optional bool cloud

    # If true, the variant requires the MLX engine (Apple Silicon)
    optional bool mlx


group "Ollama Chat API"


# Get information for the index page
action getConversations
    urls
        GET

    output
        # The current model ID
        optional string model

        # The conversations
        ConversationInfoEx[] conversations

        # The conversation templates
        ConversationTemplateInfo[] templates

        # The workspace directory
        string workspace

        # The scheduled tasks
        TaskInfo[] tasks


# Set the workspace directory
action setWorkspace
    urls
        POST

    input
        # The workspace directory path
        string path

    output
        # The workspace directory
        string workspace

    errors
        BadWorkspace


# Get the workspace and email settings. The email app password is never included.
action getSettings
    urls
        GET

    output (SettingsInfo)


# Set the email settings - the servers, ports and mailbox login are written to the workspace's
# ".env" file. The app password is write-only: an empty "password" keeps the saved password,
# and the password is never returned to the browser.
action setEmailSettings
    urls
        POST

    input
        # The IMAP server host
        string imapHost

        # The IMAP server port (the default is 993)
        optional int imapPort

        # The SMTP server host
        string smtpHost

        # The SMTP server port (the default is 465)
        optional int smtpPort

        # The mailbox login
        string user

        # The app password. An empty value keeps the saved password.
        optional string password

    output
        # True, once the ".env" file is saved
        bool saved

    errors
        BadEmailSettings


# Check the email settings - log in to the configured IMAP and SMTP servers
action testEmailConnection
    urls
        POST

    output
        # A short summary of the checked IMAP and SMTP connections
        string message

    errors
        TestFailed


# Get the user profile - the workspace memory file USER.md and its character limit. USER.md is
# added to the system prompt of every chat message.
action getProfile
    urls
        GET

    output (ProfileInfo)


# Save the user profile (memory/USER.md)
action setProfile
    urls
        POST

    input
        # The USER.md markdown content
        string content

    output
        # True, once USER.md is saved
        bool saved

    errors
        ProfileTooLong
        BadProfile


# Get the scheduled tasks' full info (the tasks page's list)
action getTasks
    urls
        GET

    output
        # The tasks
        TaskDetails[] tasks


# Create a scheduled task, or update the task's fields when "id" is present
action setTask
    urls
        POST

    input (TaskInput)

    output
        # The task identifier
        string id

    errors
        BadTask


# Delete a scheduled task
action deleteTask
    urls
        POST

    input
        # The task identifier
        string id

    errors
        UnknownTaskID


# Run a scheduled task now. The task runs in the background; poll getTasks to see the result.
action runTask
    urls
        POST

    input
        # The task identifier
        string id

    output
        # True, once the task run has started in the background
        bool started

    errors
        UnknownTaskID


# Stop a task that is currently running. The stop takes effect at the run's next chunk or tool
# round; the run then reports "stopped" as its lastError on the tasks page.
action stopTask
    urls
        POST

    input
        # The task identifier
        string id

    output
        # True, once the stop has been requested
        bool stopped

    errors
        NotRunning


# Get a scheduled task's run log. The log lines come from the workspace's logs directory.
action getTaskLog
    urls
        GET

    query
        # The task identifier
        string id

    output (TaskLog)

    errors
        UnknownTaskID


# Set the current model ID
action setModel
    urls
        POST

    input
        # The model ID
        string model

        # The model's AI provider ID (the default is "ollama")
        optional string provider


# Move a conversation
action moveConversation
    urls
        POST

    input
        # The conversation identifier
        string id

        # Move down? If not, the move is up.
        bool down

    errors
        UnknownConversationID


# Move a template
action moveTemplate
    urls
        POST

    input
        # The template identifier
        string id

        # Move down? If not, the move is up.
        bool down

    errors
        UnknownTemplateID


# Create a conversation template
action createTemplate
    urls
        POST

    input
        # The template title
        string title

        # The template command name
        optional string name

        # The template variables (e.g. "{{var}}")
        optional ConversationTemplateVariable[len > 0] variables

        # The template user prompts
        string[] prompts

    output
        # The new template identifier
        string id


# Delete a template
action deleteTemplate
    urls
        POST

    input
        # The template identifier
        string id

    errors
        UnknownTemplateID


# Get a conversation template
action getTemplate
    urls
        GET

    query
        # The template identifier
        string id

    output (ConversationTemplate)

    errors
        UnknownTemplateID


# Update a template
action updateTemplate
    urls
        POST

    input (ConversationTemplate)

    errors
        UnknownTemplateID


# Start a conversation
action startConversation
    urls
        POST

    input
        # The model ID
        optional string model

        # The AI provider ID (the default is the config's provider, or "ollama")
        optional string provider

        # The user prompt
        string user

        # If true, enable thinking mode
        optional bool think

        # If true, let the model search the web and read web pages
        optional bool search

        # If true, let the model read emails and draft emails for user approval
        optional bool email

        # The maximum number of tool-call rounds for this turn, 1-50 (default is 5)
        optional int(>= 1, <= 50) toolRounds

        # Attached files [{name, type, data}] - at most 10 files
        optional ConversationFile[len <= 10] files

    output
        # The new conversation identifier
        string id

    errors
        NoModel
        ProviderDisabled
        UnknownProvider


# Start a conversation
action startTemplate
    urls
        POST

    input
        # The model ID
        optional string model

        # The template identifier or name
        string id

        # The template variable values
        optional string{} variables

    output
        # The new conversation identifier
        string id

    errors
        MissingVariable
        NoModel
        UnknownTemplateID
        UnknownVariable


# Stop a generating conversation
action stopConversation
    urls
        POST

    input
        # The conversation identifier
        string id

    errors
        UnknownConversationID


# Get a conversation
action getConversation
    urls
        GET

    query
        # The conversation identifier
        string id

    output
        # The conversation
        ConversationEx conversation

    errors
        UnknownConversationID


# Reply to a conversation
action replyConversation
    urls
        POST

    input
        # The conversation identifier
        string id

        # The user reply prompt
        string user

        # The model ID, to switch the conversation's model
        optional string model

        # The AI provider ID, to switch the conversation's provider
        optional string provider

        # If true, enable thinking mode
        optional bool think

        # If true, let the model search the web and read web pages
        optional bool search

        # If true, let the model read emails and draft emails for user approval
        optional bool email

        # The maximum number of tool-call rounds for this turn, 1-50 (default is 5)
        optional int(>= 1, <= 50) toolRounds

        # Attached files [{name, type, data}] - at most 10 files
        optional ConversationFile[len <= 10] files

    errors
        ConversationBusy
        ProviderDisabled
        UnknownConversationID
        UnknownProvider


# Confirm or discard a model-drafted email
action sendEmail
    urls
        POST

    input
        # The conversation identifier
        string id

        # If false, discard the draft without sending (the default is true, send)
        optional bool send

    output
        # True if the email was sent, false if the draft was discarded
        bool sent

    errors
        NoEmailDraft
        SendFailed
        UnknownConversationID


# Set a conversation's title
action setConversationTitle
    urls
        POST

    input
        # The conversation identifier
        string id

        # The title
        string title

    errors
        ConversationBusy
        UnknownConversationID


# Delete a conversation
action deleteConversation
    urls
        POST

    input
        # The conversation identifier
        string id

    errors
        ConversationBusy
        UnknownConversationID


# Delete the most recent exchange of a conversation
action deleteConversationExchange
    urls
        POST

    input
        # The conversation identifier
        string id

    errors
        ConversationBusy
        UnknownConversationID


# Regenerate the model's response of the most recent exchange of a conversation
action regenerateConversationExchange
    urls
        POST

    input
        # The conversation identifier
        string id

    errors
        ConversationBusy
        UnknownConversationID


# Export a conversation or workspace memory file as PDF, saved into the workspace's exports
# directory
action exportPdf
    urls
        POST

    input
        # The conversation identifier, for a conversation export
        optional string id

        # The workspace memory file - "USER.md", "MEMORY.md" or "daily/YYYY-MM-DD.md"
        optional string file

    output
        # The exported PDF file path
        string file

    errors
        UnknownConversationID
        UnknownFile


# Get the available models
action getModels
    urls
        GET

    output
        # The current model ID
        optional string model

        # The current provider ID
        optional string provider

        # The available models
        ModelInfo[] models

        # The downloading models
        ModelDownloadInfo[] downloading

        # The most recent model download error. Present once; a subsequent getModels call omits this member.
        optional string downloadError


# Get the system info
action getSystemInfo
    urls
        GET

    output
        # The total system memory, or -1 if it could not be determined
        int memory

        # If true, the system supports MLX models (Apple Silicon)
        bool mlx


# Download a model
action downloadModel
    urls
        POST

    input
        # The model ID
        string model


# Stop a model download
action stopModelDownload
    urls
        POST

    input
        # The model ID
        string model


# Delete a downloaded model
action deleteModel
    urls
        POST

    input
        # The model ID
        string model


# Get the AI providers. The built-in providers are seeded into the config on the first call.
action getProviders
    urls
        GET

    output
        # The providers
        ProviderInfo[] providers


# Create or update an AI provider. The API key is write-only: an empty value keeps the saved
# key, "deleteApiKey" erases it.
action saveProvider
    urls
        POST

    input (ProviderInput)

    output
        # The saved provider's info
        ProviderInfo provider

        # A non-fatal warning, e.g. an insecure http:// base URL for a cloud provider
        optional string warning

    errors
        BadProvider
        UnknownProvider


# Delete a custom AI provider. Built-in providers can be disabled but not deleted.
action deleteProvider
    urls
        POST

    input
        # The provider identifier
        string id

    errors
        BuiltInProvider
        UnknownProvider


# Check a provider's connection and API key
action testProvider
    urls
        POST

    input
        # The provider identifier
        string id

    output
        # A short summary of the checked connection
        string message

    errors
        TestFailed
        UnknownProvider


# Get a provider's available models, cached for a few minutes unless "refresh" is set
action getProviderModels
    urls
        GET

    query
        # The provider identifier
        string provider

        # If true, bypass the model list cache
        optional bool refresh

    output
        # The provider's available models
        ProviderModelInfo[] models

    errors
        TestFailed
        UnknownProvider
